{
  "name": "semainier",
  "version": "1.4.0",
  "private": true,
  "description": "Planning perso en vue semaine ou mois : créneaux bloqués et tâches récurrentes.",
  "license": "MIT",
  "author": "Geoffrey Caduela",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node tests/server.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/db/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
